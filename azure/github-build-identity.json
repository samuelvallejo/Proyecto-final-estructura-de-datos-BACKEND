{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "westus" },
    "registryName": { "type": "string", "defaultValue": "bachescanai4udjwwdxkco7m" },
    "identityName": { "type": "string", "defaultValue": "bachescanai-build" }
  },
  "variables": {
    "identityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
    "registryId": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('identityName')]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[concat(parameters('identityName'), '/github-azure-branch')]",
      "dependsOn": ["[variables('identityId')]"],
      "properties": {
        "issuer": "https://token.actions.githubusercontent.com",
        "audiences": ["api://AzureADTokenExchange"],
        "subject": "repo:samuelvallejo@230025659/Proyecto-final-estructura-de-datos-BACKEND@1403716665:ref:refs/heads/codex/azure-deployment"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('registryId'), variables('identityId'), 'AcrPush')]",
      "scope": "[variables('registryId')]",
      "dependsOn": ["[variables('identityId')]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8311e382-0749-4cb8-b61a-304f252e45ec')]",
        "principalId": "[reference(variables('identityId'), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "clientId": {"type": "string", "value": "[reference(variables('identityId'), '2023-01-31').clientId]"},
    "tenantId": {"type": "string", "value": "[subscription().tenantId]"},
    "subscriptionId": {"type": "string", "value": "[subscription().subscriptionId]"},
    "registryName": {"type": "string", "value": "[parameters('registryName')]"}
  }
}
